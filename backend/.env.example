# Copy this file to .env and fill in the real values.
# .env is listed in .gitignore and must never be committed.

# Databricks SQL warehouse, from Connection details
DATABRICKS_HOST=adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapi...

# Groq, from console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback if Groq is down or retires the model
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Which sites may call this API. Comma separated, no trailing slash.
ALLOWED_ORIGINS=http://localhost:8000,https://paramsngh.github.io

# Write every question and generated query to permits.gold.query_log
LOG_QUERIES=true
